{
  "name": "pi-agent-assistant",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "iihao",
  "license": "MIT",
  "author": {
    "name": "Pi Agent contributors"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1C1C1E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iihao/pi-agent-vscode.git"
  },
  "homepage": "https://github.com/iihao/pi-agent-vscode#readme",
  "bugs": {
    "url": "https://github.com/iihao/pi-agent-vscode/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "claude",
    "chat",
    "code",
    "copilot"
  ],
  "activationEvents": [
    "onCommand:pi-agent.openChat",
    "onCommand:pi-agent.explainCode",
    "onCommand:pi-agent.refactorCode",
    "onCommand:pi-agent.generateCode",
    "onCommand:pi-agent.clearChat",
    "onCommand:pi-agent.newChat",
    "onCommand:pi-agent.focusInput",
    "onCommand:pi-agent.editLastMessage",
    "onCommand:pi-agent.cycleModel",
    "onCommand:pi-agent.cycleThinkingLevel",
    "onCommand:pi-agent.compact",
    "onCommand:pi-agent.generateCommitMessage",
    "onCommand:pi-agent.generatePullRequestDescription",
    "onCommand:pi-agent.revertLastTurn",
    "onCommand:pi-agent.cloneSession",
    "onCommand:pi-agent.openInEditor",
    "onCommand:pi-agent.openInEditorToSide",
    "onCommand:pi-agent.restartSession",
    "onCommand:pi-agent.exportDiagnostics",
    "onCommand:pi-agent.attachFile",
    "onCommand:pi-agent.attachSelection",
    "onView:pi-agent.chatView"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "pi-agent.openChat",
        "title": "%cmd.openChat%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pi-agent.explainCode",
        "title": "%cmd.explainCode%"
      },
      {
        "command": "pi-agent.refactorCode",
        "title": "%cmd.refactorCode%"
      },
      {
        "command": "pi-agent.generateCode",
        "title": "%cmd.generateCode%"
      },
      {
        "command": "pi-agent.clearChat",
        "title": "%cmd.clearChat%"
      },
      {
        "command": "pi-agent.newChat",
        "title": "%cmd.newChat%",
        "icon": "$(add)"
      },
      {
        "command": "pi-agent.focusInput",
        "title": "%cmd.focusInput%"
      },
      {
        "command": "pi-agent.editLastMessage",
        "title": "%cmd.editLastMessage%"
      },
      {
        "command": "pi-agent.cycleModel",
        "title": "%cmd.cycleModel%"
      },
      {
        "command": "pi-agent.cycleThinkingLevel",
        "title": "%cmd.cycleThinkingLevel%"
      },
      {
        "command": "pi-agent.compact",
        "title": "%cmd.compact%"
      },
      {
        "command": "pi-agent.generateCommitMessage",
        "title": "%cmd.generateCommitMessage%",
        "icon": "$(git-commit)"
      },
      {
        "command": "pi-agent.generatePullRequestDescription",
        "title": "%cmd.generatePullRequestDescription%"
      },
      {
        "command": "pi-agent.revertLastTurn",
        "title": "%cmd.revertLastTurn%"
      },
      {
        "command": "pi-agent.cloneSession",
        "title": "%cmd.cloneSession%"
      },
      {
        "command": "pi-agent.openInEditor",
        "title": "%cmd.openInEditor%",
        "icon": "$(link-external)"
      },
      {
        "command": "pi-agent.openInEditorToSide",
        "title": "%cmd.openInEditorToSide%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "pi-agent.attachFile",
        "title": "%cmd.attachFile%",
        "icon": "$(add)"
      },
      {
        "command": "pi-agent.attachSelection",
        "title": "%cmd.attachSelection%",
        "icon": "$(add)"
      },
      {
        "command": "pi-agent.restartSession",
        "title": "%cmd.restartSession%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pi-agent.exportDiagnostics",
        "title": "%cmd.exportDiagnostics%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pi-agent.explainCode",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@5"
        },
        {
          "command": "pi-agent.refactorCode",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@6"
        },
        {
          "command": "pi-agent.attachSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@7"
        },
        {
          "command": "pi-agent.attachFile",
          "group": "9_cutcopypaste@8"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-agent.explainCode",
          "when": "editorHasSelection"
        },
        {
          "command": "pi-agent.refactorCode",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "pi-agent.restartSession",
          "when": "view == pi-agent.chatView",
          "group": "navigation@1"
        },
        {
          "command": "pi-agent.openInEditor",
          "when": "view == pi-agent.chatView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "pi-agent.openInEditorToSide",
          "when": "activeWebviewPanelId != 'pi-agent.chatEditor'",
          "group": "navigation@100"
        }
      ],
      "scm/title": [
        {
          "command": "pi-agent.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-agent",
          "title": "Pi Agent",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "pi-agent": [
        {
          "type": "webview",
          "id": "pi-agent.chatView",
          "name": "%view.chat.name%",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi-agent.openChat",
        "key": "ctrl+alt+p",
        "mac": "alt+cmd+p"
      },
      {
        "command": "pi-agent.newChat",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "sideBarFocus && activeViewlet == pi-agent"
      }
    ],
    "configuration": {
      "title": "Pi Agent",
      "properties": {
        "pi-agent.pi.executable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.pi.executable%"
        },
        "pi-agent.pi.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%config.pi.arguments%"
        },
        "pi-agent.agent.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "autoConfirm",
            "restricted"
          ],
          "enumDescriptions": [
            "%config.permissionMode.ask%",
            "%config.permissionMode.autoConfirm%",
            "%config.permissionMode.restricted%"
          ],
          "default": "ask",
          "scope": "resource",
          "description": "%config.permissionMode%"
        },
        "pi-agent.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%config.notifications%"
        },
        "pi-agent.diagnostics.level": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "scope": "window",
          "description": "%config.diagnostics.level%"
        },
        "pi-agent.context.autoAttach": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%config.context.autoAttach%"
        },
        "pi-agent.context.includeDiagnostics": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%config.context.includeDiagnostics%"
        },
        "pi-agent.context.includeGit": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%config.context.includeGit%"
        },
        "pi-agent.sessions.autoName": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%config.sessions.autoName%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "build:webview": "node esbuild.webview.mjs",
    "watch:webview": "node esbuild.webview.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "esbuild": "^0.24.0",
    "eslint": "^8.0.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.1.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0"
  }
}
